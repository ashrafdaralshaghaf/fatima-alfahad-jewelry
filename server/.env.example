# Copy to .env and fill in. Never commit .env.

NODE_ENV=development            # set to "production" on the live server
PORT=3000
PUBLIC_URL=http://localhost:3000   # the public https:// address in production (used in e-mail links, cookie security)

# PostgreSQL (managed database in production). DATABASE_SSL=true for most hosted providers.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/fatima
DATABASE_SSL=false

# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Behind a reverse proxy / load balancer (Nginx, Render, Railway, ...): number of proxies in front of the app.
TRUST_PROXY=0

# E-mail (order confirmations, password reset). Without SMTP_HOST, e-mails are only printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fatima Alfahad Jewelry <no-reply@your-domain.com>
ORDER_NOTIFY_EMAIL=             # the store inbox that receives "new order / appointment / bespoke" alerts

# First administrator (used by: npm run create-admin). Leave ADMIN_PASSWORD empty to generate a strong one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
